# Copy this file to backend/.env and fill in the values. Never commit .env.

# Required
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=

# Optional: LLM correction (without it you get raw Azure OCR)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Accounts: setting APP_PASSWORD (the registration code) enables sign-up, login and server-side history
APP_PASSWORD=
# Required on a server: long random string used to sign login/reset tokens
SESSION_SECRET=

# Optional: external Postgres (e.g. Neon). Empty = local SQLite file in backend/data/
DATABASE_URL=

# Optional: password reset / email verification via Brevo
BREVO_API_KEY=
MAIL_FROM=

# Optional: monthly Azure page limit per account (0 or empty = no limit)
USER_MONTHLY_PAGES=
# Optional: Redis URL (redis:// or rediss://) so per-IP rate-limit counters survive restarts
RATE_LIMIT_STORAGE_URI=
# Optional: error tracking
SENTRY_DSN=
